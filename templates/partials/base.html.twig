{% extends '@basalt/partials/base.html.twig' %}

{% block theme_stylesheet %}
    {% set css_mode = config.theme.assets.css_mode ?? 'additive' %}

    {% if css_mode == 'compiled' %}
        {% do assets.addCss('theme://dist/css/compiled.css', 100) %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    {% set child_assets = json_decode(read_file('theme://dist/child-assets.json') ?: '{}') %}
    {% if child_assets.css ?? false %}
        {% do assets.addCss('theme://dist/css/child-plugins.css', 105) %}
    {% endif %}

    {% set css_mode = config.theme.assets.css_mode ?? 'additive' %}

    {% if css_mode != 'compiled' %}
        {% do assets.addCss('theme://dist/css/child.css', 90) %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% set child_assets = json_decode(read_file('theme://dist/child-assets.json') ?: '{}') %}

    {% if child_assets.js ?? false %}
        {% do assets.addJs('theme://dist/js/child-plugins.js', {
            group: 'bottom',
            priority: 90
        }) %}
    {% endif %}

    {% if child_assets.script ?? false %}
        {% do assets.addJs('theme://dist/js/child.js', {
            group: 'bottom',
            priority: 80
        }) %}
    {% endif %}
{% endblock %}
